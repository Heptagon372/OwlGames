# ==== Supabase ====
# 비워두면 "데모 모드"로 실행된다 (가짜 데이터로 모든 화면 미리보기, DB 쓰기 없음).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버(Server Action)에서만 사용. 가입 시 이메일 인증 없이 계정을 만들 때 쓴다.
# 비우면 supabase.auth.signUp 으로 가입하므로 대시보드에서 "Confirm email"을 꺼야 한다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ==== App ====
# 부스 안내·QR 등에 쓰는 배포 주소
NEXT_PUBLIC_APP_URL=http://localhost:3000
